{
  "name": "UniMart · Campus marketplace",
  "short_name": "UniMart",
  "description": "Buy, sell and hire on campus: books, laptops, hostel gear, tutoring, printing, repairs and rides.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f4f7",
  "theme_color": "#e8452c",
  "icons": [
    { "src": "img/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "img/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "img/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "img/logo.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Sell something", "url": "./#/sell" },
    { "name": "My orders", "url": "./#/orders" },
    { "name": "Messages", "url": "./#/messages" }
  ]
}
